# Copy this file to .env and fill in real values before running in production.

# --- Database ---
# PostgreSQL is the primary target. Point this at your local/hosted instance
# (the `medfind` database must already exist — see README for the CREATE DATABASE step).
DATABASE_URL=postgresql+psycopg2://medfind:medfind@localhost:5432/medfind

# For zero-setup local testing without Postgres installed, SQLite also works:
# DATABASE_URL=sqlite:///./medfind.db

# --- Auth / JWT ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
